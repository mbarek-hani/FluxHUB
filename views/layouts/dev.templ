package layouts

templ Developer(title string, username string, avatarUrl string, active string) {
	@Base(title) {
		<div class="flex h-screen overflow-hidden" x-data="{ sidebarOpen: localStorage.getItem('sidebarOpen') !== 'false' }" x-init="$watch('sidebarOpen', val => localStorage.setItem('sidebarOpen', val))">
			<!-- Sidebar -->
			<aside :class="sidebarOpen ? 'w-64' : 'w-20'" class="bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col shadow-sm transition-all duration-300 ease-in-out shrink-0">
				<!-- Header -->
				<div :class="sidebarOpen ? 'justify-between px-5' : 'justify-center px-2'" class="h-16 flex items-center border-b border-gray-200 dark:border-gray-700 transition-all duration-300 overflow-hidden shrink-0">
					<a href="/dev/dashboard" class="flex items-center gap-2 text-xl font-bold shrink-0">
						<img src="/static/icons/favicon.svg" alt="FluxHUB Logo" class="w-8 h-8 shrink-0"/>
						<span x-show="sidebarOpen" class="font-sans font-bold tracking-tight text-gray-900 dark:text-white shrink-0">FluxHUB Dev</span>
					</a>
					<button @click="sidebarOpen = !sidebarOpen" :class="sidebarOpen ? 'ml-2' : ''" class="p-1.5 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus:outline-none shrink-0 cursor-pointer" :title="sidebarOpen ? 'Collapse sidebar' : 'Expand sidebar'">
						<svg :class="{'rotate-180': !sidebarOpen}" class="w-5 h-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
						</svg>
					</button>
				</div>

				<!-- Navigation -->
				<nav :class="sidebarOpen ? 'px-4' : 'px-3'" class="flex-1 py-6 space-y-2 overflow-y-auto transition-all duration-300">
					<a href="/dev/dashboard" 
					   :title="!sidebarOpen ? 'Dashboard' : ''"
					   :class="sidebarOpen ? 'px-4 justify-start' : 'justify-center px-0'" 
					   class={ "flex items-center gap-3 py-3 rounded-lg font-medium transition-all duration-200 cursor-pointer shrink-0", templ.KV("bg-blue-50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-400", active == "dashboard"), templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50", active != "dashboard") }>
						<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
						</svg>
						<span x-show="sidebarOpen" class="font-medium truncate shrink-0">Dashboard</span>
					</a>
					
					<a href="/dev/submit" 
					   :title="!sidebarOpen ? 'Submit Plugin' : ''"
					   :class="sidebarOpen ? 'px-4 justify-start' : 'justify-center px-0'" 
					   class={ "flex items-center gap-3 py-3 rounded-lg font-medium transition-all duration-200 cursor-pointer shrink-0", templ.KV("bg-blue-50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-400", active == "submit"), templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50", active != "submit") }>
						<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
						</svg>
						<span x-show="sidebarOpen" class="font-medium truncate shrink-0">Submit Plugin</span>
					</a>

					<a href="/dev/profile" 
					   :title="!sidebarOpen ? 'Profile' : ''"
					   :class="sidebarOpen ? 'px-4 justify-start' : 'justify-center px-0'" 
					   class={ "flex items-center gap-3 py-3 rounded-lg font-medium transition-all duration-200 cursor-pointer shrink-0", templ.KV("bg-blue-50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-400", active == "profile"), templ.KV("text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50", active != "profile") }>
						<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
						<span x-show="sidebarOpen" class="font-medium truncate shrink-0">Profile</span>
					</a>
				</nav>

				<!-- Bottom Profile & Dropdown -->
				<div x-data="{ menuOpen: false }" class="relative p-4 border-t border-gray-200 dark:border-gray-700 shrink-0">
					<!-- Trigger -->
					<div @click="menuOpen = !menuOpen" 
						 @click.away="menuOpen = false"
						 :class="sidebarOpen ? 'justify-between px-2' : 'justify-center'"
						 class="flex items-center gap-3 py-2 rounded-lg cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors select-none">
						<div class="flex items-center gap-3 shrink-0">
							<img src={ avatarUrl } alt={ username } class="w-9 h-9 rounded-full border border-gray-200 dark:border-gray-600 object-cover shrink-0"/>
							<span x-show="sidebarOpen" class="font-semibold text-sm text-gray-900 dark:text-white truncate max-w-[110px] shrink-0">{ username }</span>
						</div>
						
						<!-- Chevron -->
						<div x-show="sidebarOpen" class="flex items-center gap-1.5 text-gray-400 dark:text-gray-500 shrink-0">
							<svg :class="{'rotate-180': menuOpen}" class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</div>
					</div>

					<!-- Dropdown Menu -->
					<div x-show="menuOpen" 
						 x-transition:enter="transition ease-out duration-150"
						 x-transition:enter-start="opacity-0 translate-y-2 scale-95"
						 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
						 x-transition:leave="transition ease-in duration-100"
						 x-transition:leave-start="opacity-100 translate-y-0 scale-100"
						 x-transition:leave-end="opacity-0 translate-y-2 scale-95"
						 :class="sidebarOpen ? 'left-4 w-[224px]' : 'left-3 w-48'"
						 class="absolute bottom-20 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-xl py-2 z-50 overflow-hidden"
						 style="display: none;"
					>
						<!-- User details for collapsed sidebar -->
						<div x-show="!sidebarOpen" class="px-4 py-2.5 border-b border-gray-100 dark:border-gray-700/60 mb-1">
							<div class="text-[10px] text-gray-400 dark:text-gray-500 uppercase font-bold tracking-wider">Signed in as</div>
							<div class="text-sm font-semibold text-gray-900 dark:text-white truncate">{ username }</div>
						</div>

						<!-- Profile Link -->
						<a href="/dev/profile" class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer">
							<svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
							Edit Profile
						</a>

						<!-- Theme Toggle Option -->
						<button @click="darkMode = !darkMode" class="w-full flex items-center justify-between px-4 py-2.5 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors cursor-pointer focus:outline-none border-none bg-transparent text-left">
							<span class="flex items-center gap-2">
								<svg x-show="!darkMode" class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
								<svg x-show="darkMode" class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
								Theme
							</span>
							<span class="text-xs text-gray-400 dark:text-gray-500" x-text="darkMode ? 'Dark' : 'Light'"></span>
						</button>

						<div class="border-t border-gray-100 dark:border-gray-700/60 my-1"></div>

						<!-- Logout -->
						<form action="/logout" method="POST" class="m-0">
							<button type="submit" class="w-full flex items-center gap-2 px-4 py-2.5 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer text-left focus:outline-none border-none bg-transparent">
								<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
								</svg>
								Logout
							</button>
						</form>
					</div>
				</div>
			</aside>

			<!-- Main Content -->
			<main class="flex-1 overflow-y-auto bg-gray-50 dark:bg-gray-900">
				<div class="max-w-7xl mx-auto p-8">
					{ children... }
				</div>
			</main>
		</div>
	}
}
