package components

templ Button(text string, buttonType string, variant string, classNames string) {
	<button
		type={ buttonType }
		class={ "px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-gray-900 cursor-pointer select-none inline-flex items-center justify-center border",
			templ.KV("bg-green-600 hover:bg-green-700 active:bg-green-800 text-white border-green-700/10 focus:ring-green-500", variant == "primary"),
			templ.KV("bg-white text-gray-700 hover:bg-gray-50 border-gray-300 focus:ring-green-500 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 dark:border-gray-600", variant == "secondary"),
			templ.KV("bg-red-600 hover:bg-red-700 active:bg-red-800 text-white border-red-700/10 focus:ring-red-500", variant == "danger"),
			classNames }
	>
		{ text }
	</button>
}
