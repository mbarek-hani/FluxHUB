package components

templ Alert(message string, variant string) {
	<div
		x-data="{
			show: true,
			remaining: 5000,
			lastTick: Date.now(),
			timer: null,
			startTimer() {
				this.lastTick = Date.now();
				this.timer = setInterval(() => {
					this.remaining -= Date.now() - this.lastTick;
					this.lastTick = Date.now();
					if (this.remaining <= 0) {
						this.close();
					}
				}, 100);
			},
			stopTimer() {
				clearInterval(this.timer);
				this.timer = null;
			},
			close() {
				this.stopTimer();
				this.show = false;
			}
		}"
		x-init="startTimer()"
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-2 sm:translate-y-0 sm:translate-x-4"
		x-transition:enter-end="opacity-100 translate-x-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-x-0"
		x-transition:leave-end="opacity-0 translate-x-4"
		@mouseenter="stopTimer()"
		@mouseleave="startTimer()"
		class={ "fixed top-6 right-6 z-50 max-w-sm w-full p-4 rounded-xl shadow-lg border flex items-start gap-3 backdrop-blur-md transition-all duration-300 hover:shadow-xl",
			templ.KV("bg-red-50/90 text-red-800 border-red-200/60 dark:bg-red-950/95 dark:text-red-300 dark:border-red-900/60", variant == "error"),
			templ.KV("bg-green-50/90 text-green-800 border-green-200/60 dark:bg-green-950/95 dark:text-green-300 dark:border-green-900/60", variant == "success"),
			templ.KV("bg-blue-50/90 text-blue-800 border-blue-200/60 dark:bg-blue-950/95 dark:text-blue-300 dark:border-blue-900/60", variant == "info") }
		role="alert"
	>
		if variant == "error" {
			<svg class="w-5 h-5 flex-shrink-0 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
			</svg>
		} else if variant == "success" {
			<svg class="w-5 h-5 flex-shrink-0 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
			</svg>
		} else {
			<svg class="w-5 h-5 flex-shrink-0 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
			</svg>
		}
		<div class="flex-1 text-sm font-medium pr-2">
			{ message }
		</div>
		<button
			@click="close()"
			class="shrink-0 text-current opacity-50 hover:opacity-100 p-0.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer transition-colors focus:outline-none focus:ring-2 focus:ring-green-500/20"
			aria-label="Close alert"
		>
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>
	</div>
}
